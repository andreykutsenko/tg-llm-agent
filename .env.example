# ── Telegram ─────────────────────────────────────────────────────────────
# Токен от @BotFather. Обязательная переменная, в код не зашивается.
TELEGRAM_BOT_TOKEN=

# ── Профиль 1: локальная модель Ollama (по умолчанию) ────────────────────
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen3:1.7b
# Локальный сервер ключ не проверяет, но SDK требует непустое значение.
LLM_API_KEY=ollama

# ── Профиль 2: облачная модель Anthropic ─────────────────────────────────
# Раскомментируйте блок ниже и закомментируйте профиль 1.
# Переключение делается ТОЛЬКО переменными, код не меняется.
#LLM_PROVIDER=anthropic
#LLM_MODEL=claude-opus-5
#LLM_API_KEY=sk-ant-...
# У claude-opus-5 размышление включено по умолчанию, и его токены считаются
# в тот же лимит вывода. При 512 ответ может оказаться пустым — поднимаем.
#LLM_MAX_TOKENS=4096
# Вместо LLM_API_KEY можно оставить стандартную ANTHROPIC_API_KEY:
#ANTHROPIC_API_KEY=sk-ant-...

# ── Общие параметры вызова модели ────────────────────────────────────────
# Первый запрос после старта Ollama долгий: модель грузится в память.
LLM_TIMEOUT_SECONDS=180
LLM_MAX_TOKENS=512
SYSTEM_PROMPT=Отвечай по-русски, кратко и по существу.
