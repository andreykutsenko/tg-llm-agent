# ── Telegram ─────────────────────────────────────────────────────────────
# Токен от @BotFather. Обязательная переменная, в код не зашивается.
TELEGRAM_BOT_TOKEN=

# Кому бот отвечает: числовые id через запятую (свой id узнать у @userinfobot).
# Пусто — отвечает всем; для агента с exec это небезопасно, при старте
# будет предупреждение в логе.
TELEGRAM_ALLOWED_IDS=

# ── Профиль 1: облачная модель Anthropic (по умолчанию в агентном режиме) ─
# Цикл требует точного попадания в формат вызова инструментов, поэтому
# дефолт здесь облачный. Переключение делается ТОЛЬКО переменными.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5
ANTHROPIC_API_KEY=sk-ant-...
# У claude-opus-5 размышление включено по умолчанию, и его токены считаются
# в тот же лимит вывода. При 512 ответ может оказаться пустым — поднимаем.
LLM_MAX_TOKENS=4096
# Вместо ANTHROPIC_API_KEY можно задать общий LLM_API_KEY:
#LLM_API_KEY=sk-ant-...

# ── Профиль 2: локальная модель Ollama ───────────────────────────────────
# Раскомментируйте блок ниже и закомментируйте профиль 1.
# Требует запущенной Ollama; в агентном режиме модель уровня qwen3:1.7b
# ошибается в вызовах инструментов — см. README.
#LLM_PROVIDER=ollama
#LLM_BASE_URL=http://127.0.0.1:11434/v1
#LLM_MODEL=qwen3:1.7b
# Локальный сервер ключ не проверяет, но SDK требует непустое значение.
#LLM_API_KEY=ollama
#LLM_MAX_TOKENS=1024

# ── Общие параметры вызова модели ────────────────────────────────────────
# Первый запрос после старта Ollama долгий: модель грузится в память.
LLM_TIMEOUT_SECONDS=180
SYSTEM_PROMPT=Отвечай по-русски, кратко и по существу.

# ── Агентный цикл ────────────────────────────────────────────────────────
# Сколько шагов «модель → инструмент → модель» разрешено на один запрос.
# Допустимый диапазон 5–10.
AGENT_MAX_STEPS=8

# ── Инструмент exec ──────────────────────────────────────────────────────
# Белый список команд: всё остальное отклоняется. Расширять осознанно.
EXEC_ALLOWLIST=curl,cat,ls,date,head,tail,wc,grep
EXEC_TIMEOUT_SECONDS=20
# Рабочий каталог подпроцесса; по умолчанию каталог проекта.
#EXEC_WORKDIR=/home/user/tg-llm-agent
# Обрезка вывода команды перед отправкой модели.
EXEC_MAX_OUTPUT=4000

# ── Скиллы ───────────────────────────────────────────────────────────────
# Все skills/*.md уходят в КАЖДЫЙ запрос; превышение лимита — ошибка старта.
SKILLS_MAX_CHARS=8000
#SKILLS_DIR=skills
